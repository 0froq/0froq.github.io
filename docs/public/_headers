# Cloudflare Pages headers (copied from docs/public → dist root).
# Hashed VitePress assets can be cached aggressively; HTML stays revalidated.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable
