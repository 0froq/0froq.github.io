{
  "backlog": {
    "prefix": "..backlog",
    "body": [
      "- title: ${1:Title}",
      "  dod: ${2:Def of Done}",
      "  status: ${3|notPlanned,arranging,deffered|}",
      "  due: ${4:Due}",
      "  links:"
    ]
  },
  "week": {
    "prefix": "..week",
    "body": [
      "theme: ${1:Theme}\n",
      "quadrants:",
      "  q1:",
      "    - title: 安排本周的任务",
      "      dod: 搞完了？我看未必……",
      "      status: notStarted",
      "      links:\n",
      "      tags:",
      "        - forIdiot\n",
      "  q2:\n",
      "  q3:\n",
      "  q4:"
    ]
  },
  "task": {
    "prefix": "..task",
    "body": [
      "- title: ${1:Title}",
      "  dod: ${2:Def of Done}",
      "  status: ${3|done,inProgress,notStarted,deffered,cancelled,blocked|}",
      "  links:\n",
      "  tags:"
    ]
  }
}
